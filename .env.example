# PAS-One Frontend Configuration
# Copy to .env and fill with your values

# Google Apps Script Deployment URL
# Get from: Apps Script > Deploy > Web app > Copy URL
APPS_SCRIPT_URL=https://script.google.com/macros/d/YOUR_DEPLOYMENT_ID/usercodeapp

# Google Sheets Spreadsheet ID
# Get from: Google Sheets URL: https://docs.google.com/spreadsheets/d/{SPREADSHEET_ID}/edit
SPREADSHEET_ID=YOUR_SPREADSHEET_ID

# Location Configuration
# Jl. Letjen H. Alamsyah Ratu Perwiranegara, Gandus, Palembang
BASE_LOCATION_LAT=-2.915
BASE_LOCATION_LNG=104.758

# Emergency Contact Information
EMERGENCY_PHONE=+62812345678
EMERGENCY_WHATSAPP=+62812345678

# Service Hours (24-hour format, Palembang time)
NORMAL_HOURS_START=06
NORMAL_HOURS_END=18
TIMEZONE=Asia/Jakarta

# Service Fees (in Rupiah)
FREE_RADIUS_KM=30
DISTANCE_OVERAGE_FEE=10000
GUEST_VISIT_FEE=250000
OFF_HOURS_VISIT_FEE=250000

# Optional: Analytics and Integrations
# GOOGLE_ANALYTICS_ID=GA-XXXXXXX
# SENTRY_DSN=https://xxx@sentry.io/yyy
